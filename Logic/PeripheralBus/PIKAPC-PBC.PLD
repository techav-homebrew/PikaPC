Name     PikaPC-PBC ;
PartNo   00 ;
Date     11/3/2025 ;
Revision 01 ;
Designer Engineer ;
Company  techav ;
Assembly None ;
Location  ;
Device   g22V10 ;

/* *************** INPUT PINS *********************/
PIN       1 = CLK                 ; /* System Clock                    */ 
PIN  [5..2] = ![CS5..2]           ; /* Chip Select signals             */ 
PIN       6 = !OE                 ; /* Output Enable                   */ 
PIN [10..7] = ![WBE3..0]          ; /* Write Enable signals            */ 
                                    /* !WBE1 = A1                      */
                                    /* !WBE0 = A0                      */
PIN      11 = !SRDY               ; /*                                 */ 

/* *************** OUTPUT PINS *********************/
PIN      16 = ADS                 ; /* VLB Address Strobe              */ 
PIN [20..17]= ![SBE3..0]          ; /* VLB Byte Enable signals         */ 
PIN      21 = !RDYIN              ; /* VLB Ready response signal       */ 
PIN      22 = READY               ; /* System Ready signal             */ 
PIN      23 = !PBDEN              ; /* Peripheral Bus data enable      */ 

/* *************** PINNODES    *********************/
PINNODE  14 = ADSQ0               ; /*                                 */
PINNODE  15 = ADSQ1               ;			 

/* Peripheral Data Bus Enable */

PBDEN = CS2 # CS3 # CS4 # CS5;

/* Byte Enables */

SBE0 = (CS2 & OE) # ((CS2 # CS3) & WBE3) # (CS3 & OE & WBE1 & WBE0);
SBE1 = (CS2 & OE) # ((CS2 # CS3) & WBE2) # (CS3 & OE & WBE1 & !WBE0);
SBE2 = (CS2 & OE) # ((CS2 # CS3) & WBE1) # (CS3 & OE & !WBE1 & WBE0);
SBE3 = (CS2 & OE) # ((CS2 # CS3) & WBE0) # (CS3 & OE & !WBE1 & !WBE0);

/* Ready */

READY = SRDY;

RDYIN.d = SRDY;
RDYIN.ar = !PBDEN;
RDYIN.sp = 'b'0;

/* Address Strobe */

ADSQ0.d = CS2 # CS3;
ADSQ1.d = ADSQ0;

ADSQ0.ar = !PBDEN;
ADSQ1.ar = !PBDEN;

ADSQ0.sp = 'b'0;
ADSQ1.sp = 'b'0;

ADS = !ADSQ0 # ADSQ1;






